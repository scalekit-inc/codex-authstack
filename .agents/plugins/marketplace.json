{
  "name": "scalekit-auth-stack",
  "owner": {
    "name": "Scalekit Inc",
    "email": "support@scalekit.com"
  },
  "interface": {
    "displayName": "Scalekit Auth Stack"
  },
  "plugins": [
    {
      "name": "agentkit",
      "source": {
        "source": "local",
        "path": "./plugins/agentkit"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Agent Auth"
    },
    {
      "name": "saaskit",
      "source": {
        "source": "local",
        "path": "./plugins/saaskit"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Application Auth"
    }
  ]
}
